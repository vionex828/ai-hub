# Copy these names into Railway → your service → Variables.
# Put the real values ONLY in Railway. Never commit them to GitHub or paste them in chat.

# --- Required ---
BASE_URL=https://ai.yourdomain.com          # your live site address, no trailing slash
DATABASE_URL=                                # Railway fills this when you add PostgreSQL (use ${{Postgres.DATABASE_URL}})
OPENROUTER_API_KEY=                          # from openrouter.ai → Keys
ADMIN_PASSWORD=                              # 12+ characters, used at /admin

# --- Brand ---
BRAND_NAME=AI Hub

# --- EPS payments (from your EPS merchant panel) ---
EPS_MERCHANT_ID=
EPS_STORE_ID=
EPS_USERNAME=
EPS_PASSWORD=
EPS_HASH_KEY=
EPS_CUSTOMER_EMAIL=support@yourdomain.com    # EPS needs an email on every payment
# EPS_SANDBOX=true                           # uncomment to test with the EPS sandbox

# --- BulkSMSBD (login codes) ---
SMS_API_KEY=
SMS_SENDER_ID=
# SMS_API_URL=https://bulksmsbd.net/api/smsapi

# --- Optional ---
# TELEGRAM_BOT_TOKEN=                        # owner alerts: paid orders, low OpenRouter credit
# TELEGRAM_CHAT_ID=
# LOW_CREDIT_USD=10
# PGSSL=true                                 # only if you connect with Railway's public database URL
# OTP_DEBUG=true                             # TESTING ONLY: shows login codes on screen. Never on in production.
